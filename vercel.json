{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php?path=/index.php"
    },
    {
      "source": "/(.*\\.php)",
      "destination": "/api/index.php?path=/$1"
    }
  ]
}
